---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import logo from '../assets/favicon.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<Image src={logo} alt="Mouldy Shoe logo" width={320} height={320} class="body-logo" />
				<h1>Mouldy Shoe</h1>
			</div>
			<p>Hi! I'm Mouldy Shoe, Rocket League's documentary guy.</p>
			<p>
				I make cinematic documentaries exploring the players, teams and moments that shape Rocket
				League. I'm based in Australia. I'm currently GC2 :D
			</p>
			<p>I'm also a creator for STARCORE.</p>
			<Footer />
		</main>
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}
	.body-logo {
		display: block;
		flex: none;
		width: 260px;
		height: auto;
		margin-left: calc(-50vw + 50% + 100px);
		border-radius: 50%;
	}
	.hero h1 {
		margin: 0;
	}
</style>
