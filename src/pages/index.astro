---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import logo from '../assets/favicon.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<Image src={logo} alt="Mouldy Shoe logo" width={320} height={320} class="body-logo" />
				<h1>Mouldy Shoe</h1>
			</div>
			<p>Hi! I'm Mouldy Shoe, Rocket League's documentary guy.</p>
			<p>
				I make cinematic documentaries exploring the players, teams and moments that shape Rocket
				League. I'm based in Australia. I'm currently GC2 :D
			</p>
			<p>I'm also a creator for STARCORE.</p>
			<ul class="stats">
				<li class="stat">
					<a href="https://youtube.com/@mouldy_shoe" target="_blank" rel="noopener">
						<span class="stat-value" data-stat="subscribers">—</span>
						<span class="stat-label">Subscribers</span>
					</a>
				</li>
				<li class="stat">
					<a href="https://youtube.com/@mouldy_shoe/videos" target="_blank" rel="noopener">
						<span class="stat-value" data-stat="videos">—</span>
						<span class="stat-label">Videos</span>
					</a>
				</li>
			</ul>
			<Footer />
		</main>
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}
	.body-logo {
		display: block;
		flex: none;
		width: 260px;
		height: auto;
		margin-left: calc(-50vw + 50% + 100px);
		border-radius: 50%;
	}
	.hero h1 {
		margin: 0;
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
		background: transparent;
		text-align: center;
	}
	.stat {
		background: transparent;
	}
	.stat a {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-decoration: none;
		color: rgb(var(--black));
		background: transparent;
		-webkit-tap-highlight-color: transparent;
	}
	.stat-value {
		font-size: 3rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(var(--black));
		font-variant-numeric: tabular-nums;
	}
	.stat-label {
		font-size: 1.1rem;
		color: rgb(var(--black));
	}
	.stat a:hover .stat-value {
		color: var(--accent);
	}
</style>

<script>
	const fmt = new Intl.NumberFormat('en', {
		notation: 'compact',
		maximumFractionDigits: 1,
	});
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	function countUp(el: Element, target: number) {
		const final = fmt.format(target);
		if (reduceMotion) {
			el.textContent = final;
			return;
		}
		const duration = 1200;
		const start = performance.now();
		const fallback = setTimeout(() => {
			el.textContent = final;
		}, duration + 250);
		let last = el.textContent;
		function frame(now: number) {
			const t = Math.min(1, (now - start) / duration);
			const eased = 1 - Math.pow(1 - t, 3);
			const next = fmt.format(Math.round(target * eased));
			if (next !== last) {
				last = next;
				el.textContent = next;
			}
			if (t < 1) {
				requestAnimationFrame(frame);
			} else {
				clearTimeout(fallback);
				if (last !== final) el.textContent = final;
			}
		}
		requestAnimationFrame(frame);
	}

	fetch('/api/stats')
		.then((r) => r.json())
		.then((data: Record<string, unknown>) => {
			document.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
				const value = data[el.dataset.stat ?? ''];
				if (typeof value === 'number') countUp(el, value);
			});
		})
		.catch(() => {});
</script>
