---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { CURRENT_RANK, RANK_TIERS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import logo from '../assets/favicon.png';

const rankIndex = RANK_TIERS.indexOf(CURRENT_RANK);
if (rankIndex === -1) {
	throw new Error(`CURRENT_RANK ("${CURRENT_RANK}") is not in RANK_TIERS — fix src/consts.ts`);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<Image src={logo} alt="Mouldy Shoe logo" width={320} height={320} class="body-logo" />
				<h1>Mouldy Shoe</h1>
			</div>
			<p>Hi! I'm Mouldy Shoe, Rocket League's documentary guy.</p>
			<p>
				I make cinematic documentaries exploring the players, teams and moments that shape Rocket
				League. I'm based in Australia. I'm currently GC2 :D
			</p>
			<p>I'm also a creator for STARCORE.</p>
			<ul class="stats">
				<li class="stat">
					<a class="stat-inner" href="https://youtube.com/@mouldy_shoe" target="_blank" rel="noopener">
						<span class="stat-value" data-stat="subscribers">—</span>
						<span class="stat-label">Subscribers</span>
					</a>
				</li>
				<li class="stat">
					<a
						class="stat-inner"
						href="https://youtube.com/@mouldy_shoe/videos"
						target="_blank"
						rel="noopener"
					>
						<span class="stat-value" data-stat="videos">—</span>
						<span class="stat-label">Videos</span>
					</a>
				</li>
				<li class="stat">
					<div class="stat-inner">
						<span class="stat-value" data-rank-index={rankIndex}>{RANK_TIERS[0]}</span>
						<span class="stat-label">Rank</span>
					</div>
				</li>
			</ul>
			<Footer />
		</main>
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 1rem;
	}
	.body-logo {
		display: block;
		flex: none;
		width: 260px;
		height: auto;
		margin-left: calc(-50vw + 50% + 100px);
		border-radius: 50%;
	}
	.hero h1 {
		margin: 0;
	}
	.stats {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 6rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
		background: transparent;
		text-align: center;
	}
	.stat {
		background: transparent;
	}
	.stat-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-decoration: none;
		color: rgb(var(--black));
		background: transparent;
		-webkit-tap-highlight-color: transparent;
	}
	.stat-value {
		font-size: 3rem;
		font-weight: 700;
		line-height: 1.2;
		color: rgb(var(--black));
		font-variant-numeric: tabular-nums;
	}
	.stat-label {
		font-size: 1.1rem;
		color: rgb(var(--black));
	}
	.stat-inner:hover .stat-value {
		color: var(--accent);
	}
</style>

<script define:vars={{ rankTiers: RANK_TIERS, rankIndex }}>
	const fmt = new Intl.NumberFormat('en', {
		notation: 'compact',
		maximumFractionDigits: 1,
	});
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	function animateEase(duration, render) {
		const start = performance.now();
		let done = false;
		const finish = () => {
			if (done) return;
			done = true;
			render(1);
		};
		const fallback = setTimeout(finish, duration + 250);
		function frame(now) {
			const t = Math.min(1, (now - start) / duration);
			render(1 - Math.pow(1 - t, 3));
			if (t < 1) {
				requestAnimationFrame(frame);
			} else {
				clearTimeout(fallback);
				finish();
			}
		}
		requestAnimationFrame(frame);
	}

	function countUp(el, target) {
		const final = fmt.format(target);
		if (reduceMotion) {
			el.textContent = final;
			return;
		}
		let last = el.textContent;
		animateEase(1200, (eased) => {
			const next = eased >= 1 ? final : fmt.format(Math.round(target * eased));
			if (next !== last) {
				last = next;
				el.textContent = next;
			}
		});
	}

	function stepRank(el, targetIndex) {
		const final = rankTiers[targetIndex];
		if (reduceMotion) {
			el.textContent = final;
			return;
		}
		let last = el.textContent;
		animateEase(1200, (eased) => {
			const idx = eased >= 1 ? targetIndex : Math.round(targetIndex * eased);
			const next = rankTiers[idx];
			if (next !== last) {
				last = next;
				el.textContent = next;
			}
		});
	}

	const rankEl = document.querySelector('[data-rank-index]');
	if (rankEl) stepRank(rankEl, rankIndex);

	fetch('/api/stats')
		.then((r) => r.json())
		.then((data) => {
			document.querySelectorAll('[data-stat]').forEach((el) => {
				const value = data[el.dataset.stat ?? ''];
				if (typeof value === 'number') countUp(el, value);
			});
		})
		.catch(() => {});
</script>
