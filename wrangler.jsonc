{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "mouldyshoe",
	"compatibility_date": "2026-09-01",
	"main": "worker/index.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"kv_namespaces": [
		{
			"binding": "STATS_KV",
			"id": "31785cecfadf480b8cb71073e38af916",
			"remote": true
		}
	],
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}